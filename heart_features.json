{
  "dataset": "Cleveland heart disease dataset",
  "target_column": "target",
  "target_mapping": {
    "0": 0,
    "1-4": 1
  },
  "positive_class": "heart disease present",
  "features": [
    "age",
    "sex",
    "cp",
    "trestbps",
    "chol",
    "fbs",
    "restecg",
    "thalach",
    "exang",
    "oldpeak",
    "slope",
    "ca",
    "thal"
  ],
  "numeric_features": [
    "age",
    "trestbps",
    "chol",
    "thalach",
    "oldpeak"
  ],
  "categorical_features": [
    "sex",
    "cp",
    "fbs",
    "restecg",
    "exang",
    "slope",
    "ca",
    "thal"
  ],
  "split": {
    "test_size": 0.2,
    "random_state": 42,
    "stratified": true
  }
}